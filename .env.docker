# ══════════════════════════════════════════════════════════════
# Bridge — Docker .env
# cp .env.docker .env → değerleri doldur → docker compose up -d
# ══════════════════════════════════════════════════════════════

# ── Zorunlu ───────────────────────────────────────────────────
# Üret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=BURAYA_UZUN_RASTGELE_STRING_YAZ
REFRESH_SECRET=BURAYA_FARKLI_UZUN_RASTGELE_STRING_YAZ

# ── PostgreSQL şifresi ────────────────────────────────────────
POSTGRES_PASSWORD=guclu_bir_sifre_yaz

# ── CORS ──────────────────────────────────────────────────────
# Domain aldıysan: https://bridge.senindomain.com
ALLOWED_ORIGINS=http://localhost:3001

# ── AI (birini seç, ücretsiz) ────────────────────────────────
# GROQ_API_KEY=gsk_xxxx
# GEMINI_API_KEY=AIzaxxxx
# OPENROUTER_API_KEY=sk-or-xxxx

# ── Email (opsiyonel) ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=senin@gmail.com
# SMTP_PASS=uygulama_sifresi
# FROM_EMAIL=noreply@bridge.app

# ── WebAuthn / Passkey ────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bridge
WEBAUTHN_ORIGIN=http://localhost:3001

# ── İçerik Tarama ────────────────────────────────────────────
CONTENT_SCAN_ENABLED=true
# VIRUSTOTAL_API_KEY=

# ── Web Push / VAPID (tarayıcı bildirimleri) ─────────────────
# Üret: npm run vapid:generate
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@bridge.app

# ── FCM — Android & iOS Native Push ─────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Seçenek A: JSON dosya yolu (Docker volume'a mount et)
# FCM_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json
# Seçenek B: JSON içeriğini tek satır string olarak
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FCM_PROJECT_ID=your-firebase-project-id

# ── Mobil Build ───────────────────────────────────────────────
# iOS/Android build için: mobile/BUILD.md dosyasına bak
# BRIDGE_SERVER_URL=https://chat.example.com   # production URL (cap sync'e set et)

# ── Mediasoup SFU (group voice) ──────────────────────────────
# Sunucunun dışarıdan erişilebilir IP'sini yaz (zorunlu, SFU için)
# Boş bırakılırsa SFU başlamaz, P2P fallback devreye girer.
# MEDIASOUP_ANNOUNCED_IP=1.2.3.4
# MEDIASOUP_RTC_MIN_PORT=40000
# MEDIASOUP_RTC_MAX_PORT=49999
# MEDIASOUP_WORKERS=1

# ── Yedekleme (opsiyonel S3/MinIO) ───────────────────────────
BACKUP_KEEP_DAYS=7
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# S3_BUCKET=
# S3_ENDPOINT=
