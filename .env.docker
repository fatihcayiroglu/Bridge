# ═══════════════════════════════════════════════════════════
# Bridge — Docker Compose ortam şablonu
# Kullanım: cp .env.docker .env  →  değerleri doldur  →  docker compose up -d
# ═══════════════════════════════════════════════════════════

# ── Zorunlu ─────────────────────────────────────────────────
# Üret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_64
REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_FROM_JWT_SECRET
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ── Production hardening override zorunluları ─────────────────
# docker-compose.prod.yml ile çalıştırırken doldur.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEDERATION_SECRET=CHANGE_ME_federation_secret_32_chars_min
AP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FROM_CRYPTO_RANDOMBYTES_32
METRICS_SECRET=CHANGE_ME_metrics_secret_32_chars_min

# ── CORS / erişim ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001

# ── AI (opsiyonel) ──────────────────────────────────────────
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── E-posta (opsiyonel) ─────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=noreply@bridge.local

# ── Web Push / VAPID (opsiyonel) ────────────────────────────
# npm run vapid:generate:docker
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ── Mediasoup SFU (opsiyonel — grup sesi) ───────────────────
# MEDIASOUP_ANNOUNCED_IP=
# MEDIASOUP_RTC_MIN_PORT=40000
# MEDIASOUP_RTC_MAX_PORT=49999

# ── CDN (opsiyonel) ─────────────────────────────────────────
CDN_PROVIDER=local
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ── Backup (opsiyonel S3) ─────────────────────────────────────
# BACKUP_KEEP_DAYS=7
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
