# ═══════════════════════════════════════════════════════════
# Bridge — Kök ortam dosyası (referans)
#
# Sunucu yapılandırması (manuel kurulum):
#   cp server/.env.example server/.env
#
# Docker Compose:
#   cp .env.docker .env
#
# İsteğe bağlı özellik bayrakları ve CDN ayarları aşağıda.
# JWT / DATABASE_URL gibi zorunlu anahtarlar server/.env içindedir.
# ═══════════════════════════════════════════════════════════

# ── Medya Depolama (Sprint 53) ────────────────────────────────────────────────
# CDN_PROVIDER=local
# CDN_PROVIDER=r2
# CDN_PROVIDER=minio
# CDN_PROVIDER=s3

# ── Feature Flags ─────────────────────────────────────────────────────────────
# BRIDGE_SVELTE_SETTINGS=true

# ── Native Push (iOS / Android) — bkz. mobile/NATIVE_PUSH_SETUP.md ───────────
# APNS_KEY_PATH=
# FCM_SERVICE_ACCOUNT_PATH=

# METRICS_SECRET=

# Sprint 93: Spotify OAuth (opsiyonel)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://yourdomain.com/api/v1/oauth/spotify/callback

# Sprint 93: E2EE Production Toggle
BRIDGE_E2EE_ENABLED=false

# ── Proxy & Rate Limiting (Sprint 119-121) ────────────────────────────────────
# Kaç adet güvenilir proxy var? (nginx, HAProxy vb.)
# 0 = doğrudan bağlantı, 1 = tek proxy (varsayılan), N = N proxy
# Yanlış ayar → IP spoofing riski (düşük) veya yanlış IP rate limiting (yüksek)
# TRUSTED_PROXY_COUNT=1

# ── Upload Boyut Limitleri ────────────────────────────────────────────────────
# Tek dosya için maksimum upload boyutu (MB cinsinden).
# Varsayılan: 500 MB — production için düşürmenizi öneririz (örn. 100)
# MAX_FILE_SIZE_MB=100
#
# Sunucu başına maksimum kanal sayısı (varsayılan: 500)
# MAX_CHANNELS_PER_SERVER=500
#
# Kullanıcı başına maksimum sahip olunan sunucu sayısı (varsayılan: 100)
# MAX_SERVERS_PER_USER=100

# ── ActivityPub Federation Rate Limiting (Sprint 119) ────────────────────────
# AP_INBOX_GLOBAL_MAX=500      # Dakikada toplam max inbox request
# AP_INBOX_GLOBAL_WINDOW=60    # Saniye cinsinden global pencere
# AP_INBOX_PEER_MAX=100        # Peer başına max request (aynı pencere)
# AP_INBOX_PEER_WINDOW=60      # Saniye cinsinden peer penceresi
# AP_INBOX_BURST_MAX=20        # 10 saniyede izin verilen burst
