# docs/cloudflare.env.example
#
# NOT: bu dosya BILEREK `.env` ile BASLAMAZ. Surum paketleyicisi guvenlik
# geregi `.env*` desenli her dosyayi ARSIVDEN DISLAR (scripts/package-release.js
# — SAFE_ENV_EXAMPLES allowlist'i). O kurali genisletmek yerine dosya adi
# degistirildi: boylece sablon operatore ulasir ve gizli-dosya korumasi
# oldugu gibi kalir.
#
# ============================================================================
# BRIDGE — CLOUDFLARE ARKASINDA URETIM ORNEGI
# ============================================================================
# Bu dosya YALNIZCA bir sablondur. GERCEK bir kimlik bilgisi ICERMEZ ve
# icermemelidir. Kopyalayin, degerleri doldurun ve kopyayi ASLA sürüm
# kontrolüne eklemeyin.
#
#   cp docs/cloudflare.env.example server/.env      # ve .gitignore'da oldugundan emin olun
#
# Bridge acilista bu degerleri dogrular (server/lib/env.ts) ve eksik/hatali
# uretim degerlerinde ACIK bir hata ile durur. Dogrulayici sirlarin
# UZUNLUGUNU bildirir, DEGERINI asla yazmaz.
#
# Yerel olarak dogrulamak icin:
#   NODE_ENV=production node server/dist/lib/env.js

# ── TEMEL ───────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# ── GENEL KIMLIK ────────────────────────────────────────────────────────────
# `bridge.example.com` yerine GERCEK alan adinizi yazin.
# HTTPS zorunludur; bu degerler baglantilarda, federasyon kimliginde ve
# WebAuthn dogrulamasinda kullanilir.
BASE_URL=https://bridge.example.com
INSTANCE_URL=https://bridge.example.com

# CORS allowlist. ASLA `*` kullanmayin.
ALLOWED_ORIGINS=https://bridge.example.com

# ── !! EN KRITIK CLOUDFLARE AYARI !! ────────────────────────────────────────
# Guvenilen proxy hop sayisi. Bridge gercek istemci IP'sini
# `X-Forwarded-For` zincirinin SONUNDAN bu kadar geriden okur.
#
#   Cloudflare + nginx  → 2      ← bu kurulumun DOGRU degeri
#   yalnizca Cloudflare → 1
#   proxy yok           → 0 / tanimsiz (XFF tamamen yok sayilir)
#
# YANLIS DEGERIN SONUCU (testle belgelenmistir —
# server/tests/cloudflare-client-ip.test.ts):
#   1 yazarsaniz Bridge, Cloudflare POP adresini istemci sanar; TUM
#   kullanicilar TEK kimlige coker; hiz siniri, IP yasagi ve paylasilan-IP
#   adaleti anlamsizlasir. Bir kisinin davranisi HERKESI etkiler.
TRUSTED_PROXY_COUNT=2

# ── WEBAUTHN / PASSKEY (guvenlik-kritik) ────────────────────────────────────
# Nihai GENEL URL ile birebir eslesmelidir. Yanlis deger, passkey'leri
# sessizce kullanilamaz kilar.
#   RP_ID  = kayit alan adi (protokol/port YOK)
#   ORIGIN = tam kaynak (https dahil)
WEBAUTHN_RP_ID=bridge.example.com
WEBAUTHN_ORIGIN=https://bridge.example.com

# ── VERITABANI ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bridge:CHANGE_ME@127.0.0.1:5432/bridge

# ── REDIS (uretimde ZORUNLU) ────────────────────────────────────────────────
# Cok ornekli calisma icin SART: Socket.IO fan-out, CSRF ve hiz-siniri
# yetkisi burada paylasilir. Redis olmadan birden fazla ornek SESSIZCE
# bozulur — kullanicilar cevrimici gorunur ama birbirinin mesajini almaz.
REDIS_URL=redis://127.0.0.1:6379

# ── SIRLAR (uretimde zorunlu; en az uzunluklar dogrulanir) ──────────────────
# Uretin:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_chars_random
REFRESH_SECRET=CHANGE_ME_min_32_chars_random
# 64 karakter HEX (32 bayt) olmalidir — federasyon anahtarlarini SIFRELER.
# Bunu yeniden uretmek, saklanan federasyon anahtarlarini OKUNAMAZ kilar.
AP_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
FEDERATION_SECRET=CHANGE_ME_min_32_chars_random
# `/metrics` ucunu korur. Cloudflare onunde olmasi bunu GEREKSIZ KILMAZ.
METRICS_SECRET=CHANGE_ME_min_16_chars

# ── CLOUDFLARE R2 (opsiyonel nesne depolama) ────────────────────────────────
# Bridge zaten S3-uyumlu depolamayi destekler; R2 icin YENI KOD GEREKMEZ.
# Kullanmiyorsaniz CDN_PROVIDER=local birakin.
#
# CDN_PROVIDER=r2
# R2_ACCOUNT_ID=CHANGE_ME
# R2_ACCESS_KEY_ID=CHANGE_ME
# R2_SECRET_ACCESS_KEY=CHANGE_ME
# R2_BUCKET=bridge-public
# # Yalnizca GERCEKTEN genel olabilecek varliklar icin. Ozel ekler/avatarlar
# # bu URL'den servis EDILMEMELIDIR; onlar Bridge yetkilendirmesinden gecer.
# R2_PUBLIC_URL=https://cdn.bridge.example.com
#
# Ozel (yetkilendirme gerektiren) icerik AYRI bir bucket'ta tutulur:
# PRIVATE_STORAGE_PROVIDER=r2
# PRIVATE_R2_BUCKET=bridge-private

# ── TURN / SFU (ses — deneysel) ─────────────────────────────────────────────
# ONEMLI: TURN medya trafigi Cloudflare'in HTTP proxy'sinden GECMEZ.
# `turn.bridge.example.com` DNS-only (gri bulut) olmalidir.
# TURN_URL=turn:turn.bridge.example.com:3478
# TURN_USERNAME=CHANGE_ME
# TURN_PASSWORD=CHANGE_ME

# ── PAYLASILAN IP / NAT AYARI ───────────────────────────────────────────────
# Okul, yurt, ofis veya CGNAT arkasindaki kullanicilar tek genel IP paylasir.
# Varsayilanlar KUCUK bir kurulum icindir; paylasilan agi olan dagitimlarda
# bilincli olarak yukseltin (bkz. docs/SHARED-IP-POLICY.md).
#
# Tek IP'den es zamanli soket tavani. Varsayilan 10 — bir okul icin DUSUKTUR.
# MAX_WS_PER_IP=100
# Kimligi dogrulanmis trafik icin IP toplam kotasi carpani. Varsayilan 20.
# RL_SHARED_IP_FACTOR=50

# ── LOGLAMA ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
