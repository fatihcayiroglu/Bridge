{
  "name": "bridge",
  "version": "1.122.0",
  "description": "Bridge — Self-host, federasyon destekli iletişim platformu",
  "repository": {
    "type": "git",
    "url": "https://github.com/bridge-app/bridge.git"
  },
  "bugs": {
    "url": "https://github.com/bridge-app/bridge/issues"
  },
  "homepage": "https://github.com/bridge-app/bridge#readme",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "prestart": "node scripts/ensure-built.js",
    "setup": "npm install && cd server && npm install && cd .. && npm run build",
    "start": "node server/dist/index.js",
    "server": "node server/dist/index.js",
    "dev": "cd server && npm run dev",
    "web": "node server/dist/index.js",
    "desktop": "cd electron && npm install && npm start",
    "mobile:setup": "node mobile/scripts/setup.js",
    "mobile:sync": "node mobile/scripts/setup.js && npx cap sync",
    "mobile:ios": "node mobile/scripts/setup.js && npx cap open ios",
    "mobile:android": "node mobile/scripts/setup.js && npx cap open android",
    "vapid:generate": "node scripts/generate-vapid.js",
    "vapid:generate:docker": "node scripts/generate-vapid.js --docker",
    "build": "node scripts/build.js",
    "build:analyze": "node scripts/build.js --analyze",
    "build:budget": "node scripts/check-bundle-budget.js",
    "build:ci": "node scripts/build.js && node scripts/check-bundle-budget.js",
    "test": "cd server && npm test",
    "lint": "cd server && npm run lint",
    "typecheck:server": "npx tsc -p server/tsconfig.json --noEmit",
    "typecheck:client": "npx tsc -p client/tsconfig.json --noEmit",
    "typecheck:bot-sdk": "npx tsc -p bot-sdk/tsconfig.json --noEmit",
    "typecheck:plugins": "npx tsc -p plugins/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:electron && npm run typecheck:bot-sdk && npm run typecheck:plugins",
    "verify:all": "npm run lint && npm run typecheck && npm run typecheck:strict-client && npm run typecheck:client-bridge5 && npm run test",
    "build:watch": "node scripts/build.js --watch",
    "desktop:build": "cd electron && npm install && npm run build",
    "desktop:win": "cd electron && npm install && npm run dist:win",
    "desktop:mac": "cd electron && npm install && npm run dist:mac",
    "desktop:linux": "cd electron && npm install && npm run dist:linux",
    "mobile:add": "npx cap add ios && npx cap add android",
    "mobile:init": "node mobile/scripts/setup.js && npx cap add ios && npx cap add android && npx cap sync",
    "typecheck:electron": "npx tsc -p electron/tsconfig.json --noEmit",
    "typecheck:strict-client": "npx tsc -p client/tsconfig.strict.json --noEmit",
    "typecheck:client-bridge5": "npx tsc -p client/tsconfig.bridge5.json --noEmit",
    "typecheck:svelte": "npx svelte-check --tsconfig ./client/tsconfig.json --output machine-warnings",
    "build:svelte-check": "npm run typecheck:svelte",
    "test:svelte": "cd client && npx vitest run --config vitest.config.mts",
    "test:svelte:coverage": "cd client && npx vitest run --config vitest.config.mts --coverage",
    "mobile:build": "node mobile/scripts/setup.js",
    "mobile:build:ci": "node mobile/scripts/setup.js && echo \"✅ mobile www/ build tamamlandı\"",
    "package:release": "bash scripts/package-release.sh",
    "test:ci-local": "bash scripts/ci-local.sh",
    "demo": "bash scripts/demo.sh",
    "check:brand": "bash scripts/check-brand-colors.sh",
    "quality:gate": "bash scripts/quality-gate.sh",
    "deploy:preflight": "bash scripts/production-preflight.sh",
    "e2e:smoke": "cd e2e && npx playwright test tests/smoke-health.spec.ts --project=api-smoke",
    "compose:prod:config": "docker compose -f docker-compose.yml -f docker-compose.prod.yml config",
    "compose:prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/node": "^25.9.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "redis": "^6.0.0",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1068.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-jest": "^30.4.1",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.10",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "author": "Bridge Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "mobile",
    "bot-sdk",
    "plugins"
  ],
  "overrides": {
    "glob": "13.0.6",
    "rimraf": "6.1.3",
    "picomatch": "4.0.4"
  }
}
