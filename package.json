{
  "name": "bridge",
  "version": "1.0.0",
  "description": "Bridge — Connect with anyone, anywhere (PostgreSQL)",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "start": "node server/dist/index.js",
    "server": "node server/dist/index.js",
    "dev": "cd server && nodemon index.js",
    "web": "node server/dist/index.js",
    "desktop": "cd electron && npm install && npm start",
    "mobile:setup": "node mobile/scripts/setup.js",
    "mobile:sync": "node mobile/scripts/setup.js && npx cap sync",
    "mobile:ios": "node mobile/scripts/setup.js && npx cap open ios",
    "mobile:android": "node mobile/scripts/setup.js && npx cap open android",
    "vapid:generate": "node scripts/generate-vapid.js",
    "vapid:generate:docker": "node scripts/generate-vapid.js --docker",
    "build": "node scripts/build.js",
    "build:analyze": "node scripts/build.js --analyze",
    "build:budget": "node scripts/check-bundle-budget.js",
    "build:ci": "node scripts/build.js && node scripts/check-bundle-budget.js",
    "test": "cd server && npm test",
    "test:socket": "cd server && npm run test:socket",
    "lint": "cd server && npm run lint",
    "typecheck:server": "npx tsc -p server/tsconfig.json --noEmit",
    "typecheck:client": "echo '⏭️  Client TypeScript check skipped during migration phase'",
    "typecheck:session4": "npx tsc -p server/tsconfig.session4.json --noEmit",
    "typecheck:session5": "npx tsc -p client/tsconfig.session5.json --noEmit",
    "typecheck": "npm run typecheck:server",
    "verify:all": "npm run lint && npm run typecheck && npm run test",
    "build:watch": "node scripts/build.js --watch",
    "desktop:build": "cd electron && npm install && npm run dist",
    "desktop:win": "cd electron && npm install && npm run dist:win",
    "desktop:mac": "cd electron && npm install && npm run dist:mac",
    "desktop:linux": "cd electron && npm install && npm run dist:linux",
    "mobile:add": "npx cap add ios && npx cap add android",
    "mobile:init": "node mobile/scripts/setup.js && npx cap add ios && npx cap add android && npx cap sync"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.3",
    "pino": "^9.14.0",
    "redis": "^4.6.13",
    "socket.io": "^4.6.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@eslint/js": "^9.0.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "author": "Bridge Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
