{
  "name": "bridge-bot-sdk",
  "version": "2.0.0",
  "description": "Bridge Chat için resmi Bot SDK (TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "keywords": ["bridge", "chat", "bot", "sdk", "typescript", "discord-alternative"],
  "license": "MIT",
  "scripts": {
    "build":       "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "typecheck":   "tsc --project tsconfig.json --noEmit",
    "clean":       "rm -rf dist .tsbuildinfo",
    "prepublish":  "npm run build"
  },
  "dependencies": {
    "eventemitter3":    "^5.0.1",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript":  "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
