# Test Environment Configuration
NODE_ENV=test

# Database
DATABASE_URL=postgresql://postgres:test@localhost:5432/bridge_test
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=test-jwt-secret-key-do-not-use-in-production
REFRESH_SECRET=test-refresh-secret-key-do-not-use-in-production

# Server Config
PORT=3001
INSTANCE_NAME=Bridge Test
INSTANCE_URL=http://localhost:3001

# File Uploads
MAX_FILE_SIZE_MB=50

# Disable external services in test
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=

# Test flags
ENABLE_MOCK_SERVICES=true
