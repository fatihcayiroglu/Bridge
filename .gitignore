# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
coverage/
.nyc_output/
client/dist/
client/assets/asset-manifest.json

# Environment / secrets
.env
.env.*
!.env.example
!.env.docker
!.env.test.example

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
__MACOSX/
*.pid
*.seed

# Uploads / generated media
uploads/
tmp/
temp/
server/uploads/
server/tmp/

# IDE
.vscode/
.idea/

# Local quality gate logs
.quality-logs/

# TypeScript incremental build cache
*.tsbuildinfo

# CI/lint tarafindan uretilen raporlar -- surumlenmez.
# `jest --outputFile` ve `eslint -f json -o` ciktilari; birlikte ~9 MB.
jest-results.json
eslint-errors.json

# Capacitor generated web root
mobile/www/

# e2e ölçüm raporları (yerel koşum çıktısı) -- sürümlenmez, pakete girmez.
e2e/_*-report.json

# Generated native build outputs -- never source (curated sources: mobile/android, mobile/ios,
# electron/*). Also excluded by scripts/package-release.js and .dockerignore.
electron/release/
/android/
/ios/
