{
  "name": "@bridge/mobile-native",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:core": "node node_modules/typescript/bin/tsc -p ../../packages/core/tsconfig.build.json",
    "pretest": "npm run build:core",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios",
    "pretypecheck": "npm run build:core"
  },
  "dependencies": {
    "@bridge/core": "file:../../packages/core",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-url-polyfill": "4.0.0",
    "tr46": "7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.0",
    "@types/tr46": "5.0.1",
    "eslint": "^8.19.0",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "test-renderer": "1.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.19.0 || ^24.3.0 || >=26.0.0"
  }
}
