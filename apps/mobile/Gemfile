source 'https://rubygems.org'

ruby '>= 3.3.0'

# CocoaPods 1.17 requires xcodeproj >= 1.28.1. Pin the compatible pair rather
# than retaining the older template's contradictory xcodeproj < 1.26 bound.
gem 'cocoapods', '1.17.0'
gem 'xcodeproj', '1.28.1'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
