{
  "expo": {
    "name": "Bridge Native Pilot",
    "slug": "bridge-native-pilot",
    "scheme": ["bridge-native-pilot", "com.bridge.nativepilot"],
    "version": "0.0.1",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bridge.nativepilot",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bridge.nativepilot",
      "allowBackup": false
    },
    "plugins": [
      ["expo-sqlite", { "useSQLCipher": true }],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
