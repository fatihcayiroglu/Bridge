{
  "name": "bridge-electron",
  "version": "1.125.0",
  "description": "Bridge — Desktop Application",
  "author": {
    "name": "Bridge Contributors"
  },
  "bridgeDesktop": {
    "allowUnsignedUpdates": false
  },
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run compile && electron .",
    "dev": "ELECTRON_DEV=true npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "test": "jest --config ./jest.electron.config.ts",
    "compile": "rm -rf dist && tsc -p tsconfig.build.json",
    "dist": "npm run build",
    "dist:win": "npm run compile && electron-builder --win",
    "dist:mac": "npm run compile && electron-builder --mac",
    "dist:linux": "npm run compile && electron-builder --linux",
    "icons": "node scripts/build-icons.cjs"
  },
  "build": {
    "appId": "com.bridge.desktop",
    "productName": "Bridge",
    "copyright": "Copyright © 2026 Bridge Contributors",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "assets/icon.png",
      "assets/tray.png",
      "static/**/*",
      "package.json",
      "!node_modules/.cache"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "Bridge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "category": "Network;InstantMessaging",
      "synopsis": "Self-hosted federated communication platform"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bridge",
      "uninstallDisplayName": "Bridge",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "protocols": [
      {
        "name": "Bridge Protocol",
        "schemes": [
          "bridge"
        ]
      }
    ],
    "toolsets": {
      "winCodeSign": "1.1.0"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.21"
  }
}
