{
  "name": "bridge-electron",
  "version": "1.122.0",
  "description": "Bridge — Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run compile && electron .",
    "dev": "ELECTRON_DEV=true npm run compile && electron .",
    "build": "npm run compile && electron-builder",
    "test": "jest --config ./jest.electron.config.ts",
    "compile": "rm -rf dist && tsc -p tsconfig.build.json",
    "dist": "npm run build",
    "dist:win": "npm run compile && electron-builder --win",
    "dist:mac": "npm run compile && electron-builder --mac",
    "dist:linux": "npm run compile && electron-builder --linux"
  },
  "build": {
    "appId": "com.bridge.desktop",
    "productName": "Bridge",
    "copyright": "Copyright © 2026 Bridge Contributors",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../client",
        "to": "client"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signtoolOptions": {
        "certificateFile": "${WIN_CERT_PATH}",
        "certificatePassword": "${WIN_CERT_PASSWORD}",
        "publisherName": "Bridge Contributors"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "category": "Network;InstantMessaging",
      "synopsis": "Self-hosted federated communication platform"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "bridge-app",
      "repo": "bridge"
    },
    "protocols": [
      {
        "name": "Bridge Protocol",
        "schemes": [
          "bridge"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "glob": "13.0.6",
    "rimraf": "6.1.3"
  }
}
