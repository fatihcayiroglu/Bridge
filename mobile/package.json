{
  "name": "bridge-mobile",
  "version": "1.122.0",
  "description": "Bridge Chat — iOS & Android (Capacitor)",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/setup.js",
    "sync": "npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "run:ios": "npx cap run ios",
    "run:android": "npx cap run android",
    "setup": "node scripts/setup.js",
    "mobile:build": "node scripts/setup.js",
    "test": "npx jest --config ../jest.mobile.config.js --passWithNoTests",
    "test:coverage": "npx jest --config ../jest.mobile.config.js --coverage --passWithNoTests"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
