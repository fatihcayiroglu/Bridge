<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════════
  DEBUG-ONLY MANIFEST OVERLAY — YEREL GELİŞTİRME AĞI
  ════════════════════════════════════════════════════════════════════════════

  ── KAPATILAN GERÇEK KUSUR (Final21, Faz 3) ────────────────────────────────
  `res/xml/network_security_config.xml` depoda vardı, doğru içeriği taşıyordu
  (yalnızca `localhost` ve `10.0.2.2` için açık metin) ve bir testle de
  kilitlenmişti — ama HİÇBİR MANİFEST ONA ATIFTA BULUNMUYORDU.

  Sonuç: dosya ÖLÜ koddu. Android 9'dan (API 28) beri açık metin varsayılan
  olarak kapalı olduğu için, emülatörde `http://10.0.2.2:3000` üzerinden
  çalışan bir geliştirme sunucusuna bağlanmak SESSİZCE başarısız oluyordu —
  ve dosyanın varlığı "çözülmüş" izlenimi veriyordu.

  ── NEDEN MAIN DEĞİL, DEBUG ────────────────────────────────────────────────
  Yapılandırmayı `src/main/AndroidManifest.xml`e koymak da kusuru kapatırdı,
  ama SÜRÜM (release) paketine de loopback açık metin istisnası taşırdı.
  Gerek yok: istisna yalnızca geliştirme içindir.

  Bu overlay yalnızca `debug` varyantına uygulanır
  (`applicationIdSuffix ".debug"`). Üretim paketi DEĞİŞMEZ: açık metin her
  alan adı için kapalı kalır. Yani bu bir GEVŞETME değil, ölü bir dosyanın
  DOĞRU KAPSAMDA canlandırılmasıdır.

  Kilit: `mobile/tests/android-manifest-security.test.js`
    · main manifest açık metin İZNİ TAŞIMAZ (ne öznitelik ne de yapılandırma)
    · debug overlay yapılandırmaya ATIFTA BULUNUR
    · yapılandırma yalnızca loopback/emülatör adreslerini içerir
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <application
    android:networkSecurityConfig="@xml/network_security_config"
    tools:replace="android:networkSecurityConfig">
    <!-- P7 Android #209: a native-only isolated DEBUG baseline. Not released,
         not the launcher, and does not initialize a WebView or any fonts. -->
    <activity
      android:name="com.bridge.app.FontBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- DEBUG-only AndroidX AppCompat Activity baseline: same provider
         probe without any WebView or Bridge application code. -->
    <activity
      android:name="com.bridge.app.AppCompatBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@style/AppTheme" />
    <!-- Constructor-only WebView in a native DEBUG Activity: no view
         attachment, navigation, Bridge content or Capacitor plugins. -->
    <activity
      android:name="com.bridge.app.WebViewConstructorBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Debug-only WebView attached to the Activity, with NO page navigation. -->
    <activity
      android:name="com.bridge.app.WebViewAttachedBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- DEBUG-only: navigation to about:blank without attaching WebView. -->
    <activity
      android:name="com.bridge.app.WebViewUnattachedNavigationBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Debug-only in-memory HTML navigation comparator: no external URL,
         JavaScript, Bridge content, network or Capacitor plugins. -->
    <activity
      android:name="com.bridge.app.WebViewDataBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Debug-only data:-scheme HTML navigation independent of about:blank;
         no scripts, network, Bridge web assets or Capacitor plugins. -->
    <activity
      android:name="com.bridge.app.WebViewDataSchemeBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Debug-only: release a navigated WebView within the SAME foreground
         Android process and measure provider reference lifetime, without
         killing GMS or changing the product/release Activity. -->
    <activity
      android:name="com.bridge.app.WebViewTeardownBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Same base Android theme; instantiate an inert, JavaScript-disabled
         about:blank WebView without Capacitor or Bridge assets. Debug only. -->
    <activity
      android:name="com.bridge.app.WebViewBaselineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />
  </application>

</manifest>
