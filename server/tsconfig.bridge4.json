{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "noEmit": true
  },
  "include": [
    "socket/**/*.ts",
    "jobs/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": ["node_modules", "dist-session4"]
}
