    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.4.1",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@aws-sdk/lib-storage": "^3.1068.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.1"
  },
