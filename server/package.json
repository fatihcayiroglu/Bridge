{
  "name": "bridge-server",
  "version": "1.122.0",
  "description": "Bridge chat server",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "node ../scripts/check-node-version.js",
    "start": "node dist/index.js",
    "start:ts": "ts-node --project tsconfig.json index.ts",
    "dev": "ts-node-dev --project tsconfig.json --respawn --transpile-only index.ts",
    "dev:js": "nodemon index.js",
    "build": "npm run build:plugins && tsc -p tsconfig.build.json",
    "build:plugins": "node scripts/build-plugins.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "db:migrate": "node db/migrate.js up",
    "db:schema": "ts-node --project tsconfig.json db/postgres/index.ts",
    "db:migrate:pg": "ts-node --project tsconfig.json db/migrate-postgres.ts up",
    "db:migrate:pg:status": "ts-node --project tsconfig.json db/migrate-postgres.ts status",
    "audit:check": "npm audit --audit-level=high --production",
    "typecheck:test-strict": "tsc -p tsconfig.test-strict.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
