{
  "name": "bridge-server",
  "version": "1.125.0",
  "description": "Bridge chat server",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "node ../scripts/check-node-version.js",
    "start": "node dist/index.js",
    "start:ts": "ts-node --project tsconfig.json index.ts",
    "dev": "ts-node-dev --project tsconfig.json --respawn --transpile-only index.ts",
    "build": "npm run build:plugins && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.cjs",
    "build:plugins": "node scripts/build-plugins.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck:test-strict && jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "db:schema": "ts-node --project tsconfig.json db/postgres/index.ts",
    "db:migrate:pg": "node dist/db/migrate-postgres.js up",
    "db:migrate:pg:status": "node dist/db/migrate-postgres.js status",
    "audit:check": "npm audit --audit-level=high --omit=dev",
    "typecheck:test-strict": "node scripts/check-typescript-debt.cjs --project tsconfig.test-strict.json --bucket testStrict",
    "typecheck:test-strict:raw": "tsc -p tsconfig.test-strict.json --noEmit",
    "test:security": "node scripts/run-security-corpus.cjs",
    "db:least-privilege": "node scripts/db-least-privilege-proof.cjs",
    "chaos:db": "node scripts/db-chaos.cjs",
    "chaos:deps": "node scripts/dependency-chaos.cjs",
    "sfu:proof": "node scripts/sfu-runtime-proof.cjs",
    "db:roles": "node scripts/db-role-setup.cjs",
    "db:roles:verify": "node scripts/db-role-setup.cjs --verify",
    "sfu:media": "node scripts/sfu-media-proof.cjs",
    "test:pg": "node scripts/require-env.cjs PG_TEST_URL && jest --config jest.pg.config.js --runInBand --forceExit",
    "db:migrate:pg:down": "node dist/db/migrate-postgres.js down",
    "db:migrate:pg:rollback": "node dist/db/migrate-postgres.js rollback",
    "db:migrate:pg:source": "ts-node --project tsconfig.json db/migrate-postgres.ts up",
    "db:migrate:pg:source:status": "ts-node --project tsconfig.json db/migrate-postgres.ts status",
    "check:prod-deps": "node scripts/check-production-deps.cjs",
    "check:coverage-debt": "node scripts/check-coverage-debt.cjs",
    "typecheck:hardening": "node scripts/check-typescript-debt.cjs --project tsconfig.hardening.json --bucket hardening",
    "typecheck:hardening:raw": "tsc -p tsconfig.hardening.json --noEmit",
    "test:mutation": "node scripts/mutation-campaign.cjs",
    "test:search-it": "node scripts/require-env.cjs SEARCH_IT_DATABASE_URL && jest --runInBand --forceExit --testPathPatterns unified-search.integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/credential-provider-node": "^3.972.66",
    "@smithy/signature-v4": "^5.6.4",
    "@smithy/types": "^4.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "undici": "8.10.2",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "xml-crypto": "6.1.2"
  },
  "optionalDependencies": {
    "@aws-sdk/lib-storage": "^3.1068.0",
    "mediasoup": "^3.26.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json",
          "diagnostics": false
        }
      ],
      "^.+\\.(js|mjs|cjs)$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "setupFiles": [
      "./tests/setup.js"
    ],
    "collectCoverageFrom": [
      "routes/**/*.ts",
      "middleware/**/*.ts",
      "lib/**/*.ts",
      "db/**/*.ts",
      "app/**/*.ts",
      "jobs/**/*.ts",
      "socket/**/*.ts",
      "!node_modules/**",
      "socket/handlers/mediasoup/**/*.ts",
      "../plugins/allowlist.ts",
      "../plugins/word-filter/index.ts",
      "../plugins/welcome-bot/index.ts",
      "../plugins/auto-role/index.ts",
      "plugins/actions.ts",
      "plugins/loader.ts",
      "./socket/handlers/messages-send.ts",
      "./socket/handlers/messages-edit.ts",
      "routes/admin/federation-keys.ts",
      "./socket/handlers/mediasoup/index.ts",
      "lib/webauthn-crypto.ts",
      "lib/webauthn-pem.ts",
      "routes/admin/users.ts",
      "routes/admin/moderation.ts",
      "routes/admin/middleware.ts",
      "!**/*.d.ts",
      "!socket/contracts.ts",
      "!socket/handlers/mediasoup/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "lines": 90,
        "functions": 90,
        "branches": 90
      },
      "./middleware/auth.ts": {
        "lines": 86,
        "functions": 92,
        "branches": 79
      },
      "./middleware/rateLimit.ts": {
        "lines": 96,
        "functions": 95,
        "branches": 96
      },
      "./lib/apKeyEncryption.ts": {
        "lines": 79,
        "functions": 99,
        "branches": 56
      },
      "./lib/permissions.ts": {
        "lines": 90,
        "functions": 86,
        "branches": 77
      },
      "./db/repositories/UserRepository.ts": {
        "lines": 74,
        "functions": 85,
        "branches": 34
      },
      "./db/repositories/AuthRepository.ts": {
        "lines": 76,
        "functions": 79,
        "branches": 56
      },
      "./routes/discover.ts": {
        "lines": 90,
        "functions": 79,
        "branches": 76
      },
      "./routes/semantic.ts": {
        "lines": 75,
        "functions": 64,
        "branches": 44
      },
      "./socket/handlers/discover.ts": {
        "lines": 99,
        "functions": 99,
        "branches": 99
      },
      "./routes/servers/channels.ts": {
        "lines": 99,
        "functions": 79,
        "branches": 72
      },
      "./routes/messages.ts": {
        "lines": 90,
        "functions": 74,
        "branches": 73
      },
      "./routes/bots.ts": {
        "lines": 95,
        "functions": 99,
        "branches": 77
      },
      "./routes/channelPerms/helpers.ts": {
        "lines": 57,
        "functions": 65,
        "branches": 44
      },
      "./lib/pushSender.ts": {
        "lines": 71,
        "functions": 52,
        "branches": 54
      },
      "./socket/handlers/mediasoup/workers.ts": {
        "lines": 90,
        "functions": 91,
        "branches": 79
      },
      "./socket/handlers/mediasoup/rooms.ts": {
        "lines": 72,
        "functions": 54,
        "branches": 60
      },
      "./socket/handlers/mediasoup/index.ts": {
        "lines": 89,
        "functions": 64,
        "branches": 71
      },
      "./socket/socketRateLimit.ts": {
        "lines": 84,
        "functions": 82,
        "branches": 70
      },
      "./lib/webauthn-crypto.ts": {
        "lines": 81,
        "functions": 99,
        "branches": 66
      },
      "./lib/webauthn-pem.ts": {
        "lines": 99,
        "functions": 99,
        "branches": 74
      },
      "./routes/admin/users.ts": {
        "lines": 90,
        "functions": 87,
        "branches": 83
      },
      "./routes/admin/moderation.ts": {
        "lines": 77,
        "functions": 56,
        "branches": 68
      },
      "./routes/admin/middleware.ts": {
        "lines": 99,
        "functions": 99,
        "branches": 82
      },
      "./socket/handlers/messages-send.ts": {
        "lines": 82,
        "functions": 77,
        "branches": 68
      },
      "./socket/handlers/messages-edit.ts": {
        "lines": 87,
        "functions": 76,
        "branches": 71
      },
      "plugins/actions.ts": {
        "lines": 93,
        "functions": 99,
        "branches": 72
      },
      "routes/admin/federation-keys.ts": {
        "lines": 99,
        "functions": 99,
        "branches": 99
      },
      "./lib/vault.ts": {
        "lines": 80,
        "functions": 89,
        "branches": 71
      },
      "./lib/pgvector.ts": {
        "lines": 95,
        "functions": 83,
        "branches": 89
      }
    },
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@middleware/(.*)$": "<rootDir>/middleware/$1",
      "^@routes/(.*)$": "<rootDir>/routes/$1",
      "^@lib/(.*)$": "<rootDir>/lib/$1",
      "^@db/(.*)$": "<rootDir>/db/$1",
      "^@jobs/(.*)$": "<rootDir>/jobs/$1",
      "^@socket/(.*)$": "<rootDir>/socket/$1",
      "^@app/(.*)$": "<rootDir>/app/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^mediasoup$": "<rootDir>/tests/__mocks__/mediasoup.ts",
      "^uuid$": "<rootDir>/tests/shims/uuid.cjs"
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules[/\\\\](?!.*(?:htmlparser2|domhandler|domutils|dom-serializer|domelementtype|entities|parse-srcset|picocolors|is-plain-object|deepmerge|escape-string-regexp)[/\\\\])"
    ]
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "babel-plugin-istanbul": {
      "test-exclude": "^7.0.2"
    },
    "glob": "13.0.6",
    "rimraf": "6.1.3",
    "js-yaml": "4.3.2",
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.2",
    "body-parser": "2.3.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "socket.io-parser": "4.2.7",
    "qs": "6.16.0",
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.21"
  }
}
