{
  "name": "bridge-server",
  "version": "1.0.0",
  "description": "Bridge chat server",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "node ../scripts/check-node-version.js",
    "start": "node dist/index.js",
    "start:ts": "ts-node --project tsconfig.json index.ts",
    "dev": "ts-node-dev --project tsconfig.json --respawn --transpile-only index.ts",
    "dev:js": "nodemon index.js",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.json --noEmit --strict",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "db:migrate": "node db/migrate.js up",
    "db:migrate:pg": "node db/migrate-postgres.js up",
    "audit:check": "npm audit --audit-level=high --production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ip": "^2.0.1",
    "jsonwebtoken": "^9.0.0",
    "mediasoup": "^3.14.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.13",
    "socket.io": "^4.6.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@aws-sdk/lib-storage": "^3.620.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.18",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.0.0",
    "express-rate-limit": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json",
          "diagnostics": false
        }
      ],
      "^.+\\.js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "collectCoverageFrom": [
      "routes/**/*.ts",
      "middleware/**/*.ts",
      "lib/**/*.ts",
      "db/**/*.ts",
      "app/**/*.ts",
      "jobs/**/*.ts",
      "!node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 65,
        "branches": 60
      }
    },
    "testTimeout": 10000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@middleware/(.*)$": "<rootDir>/middleware/$1",
      "^@routes/(.*)$": "<rootDir>/routes/$1",
      "^@lib/(.*)$": "<rootDir>/lib/$1",
      "^@db/(.*)$": "<rootDir>/db/$1",
      "^@jobs/(.*)$": "<rootDir>/jobs/$1",
      "^@socket/(.*)$": "<rootDir>/socket/$1",
      "^@app/(.*)$": "<rootDir>/app/$1"
    },
    "setupFilesAfterFramework": [
      "./tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}