# ═══════════════════════════════════════════════════════════
# Bridge — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyala: cp .env.example .env
# Güvenlik anahtarlarını mutlaka yeniden üret!
# ═══════════════════════════════════════════════════════════

# ── Zorunlu: Güvenlik ────────────────────────────────────────
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_64
REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_FROM_JWT_SECRET

# ── Zorunlu: Veritabanı ──────────────────────────────────────
DATABASE_URL=postgresql://bridge:password@localhost:5432/bridge

# ── Sunucu ──────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001

# ── Redis (production / çoklu instance için zorunlu) ─────────
# REDIS_URL=redis://localhost:6379

# ── Federasyon (ActivityPub — opsiyonel) ─────────────────────
# INSTANCE_NAME=Bridge
# INSTANCE_URL=https://bridge.example.com
# FEDERATION_SECRET=CHANGE_ME_openssl_rand_hex_32
# FEDERATION_ENABLED=false

# ── AI sağlayıcıları (opsiyonel — biri yeterli) ──────────────
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434

# ── JWT Token Süreleri ───────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Web Push / VAPID (opsiyonel) ─────────────────────────────
# Üretmek için: npm run vapid:generate
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ── E-posta (opsiyonel) ──────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Bridge <noreply@example.com>

# ── AI Özellikleri (opsiyonel) ───────────────────────────────
# AI_PROVIDER=openai | gemini | ollama
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── WebAuthn / Passkey (opsiyonel) ───────────────────────────
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3001
# WEBAUTHN_RP_NAME=Bridge

# ── Sentry Error Tracking (opsiyonel) ────────────────────────
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# BRIDGE_APP_VERSION=1.0.0
# BRIDGE_ENV=production
# INSTANCE_URL=https://bridge.example.com
# FEDERATION_ENABLED=true

# AP_ENCRYPTION_KEY — FEDERATION_ENABLED=true ise ZORUNLU
# ActivityPub private key'leri DB'de AES-256-GCM ile şifreler.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UYARI: Bu anahtarı kaybedersen federation özel anahtarları kurtarılamaz!
# AP_ENCRYPTION_KEY=

# ── CDN / Medya Depolama (opsiyonel) ─────────────────────────
# CDN_PROVIDER=local          → sunucu diski (varsayılan, geliştirme için)
# CDN_PROVIDER=r2             → Cloudflare R2 (ücretsiz egress, önerilir)
# CDN_PROVIDER=b2             → Backblaze B2
# CDN_PROVIDER=minio          → self-hosted MinIO
CDN_PROVIDER=local

# Cloudflare R2 (CDN_PROVIDER=r2 seçildiğinde)
# R2_ACCOUNT_ID=              → Cloudflare hesap ID (dash.cloudflare.com → sağ alt)
# R2_ACCESS_KEY_ID=           → R2 API token'ından
# R2_SECRET_ACCESS_KEY=       → R2 API token'ından
# R2_BUCKET=bridge-uploads
# R2_PUBLIC_URL=https://cdn.example.com   → R2 custom domain veya r2.dev URL

# Backblaze B2 (CDN_PROVIDER=b2 seçildiğinde)
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET_NAME=bridge-uploads
# B2_REGION=us-west-004
# B2_PUBLIC_URL=              → opsiyonel; yoksa otomatik üretilir

# MinIO (CDN_PROVIDER=minio seçildiğinde)
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=bridge-uploads
# MINIO_PUBLIC_URL=           → opsiyonel; yoksa MINIO_ENDPOINT/bucket kullanılır

# ── WebP Otomatik Dönüşüm (opsiyonel) ───────────────────────
# Yüklenen JPEG/PNG/TIFF/BMP dosyalarını otomatik WebP'ye çevirir.
# Aktif etmek için: npm install sharp (server/ altında)
# GIF ve SVG animasyon/vektör korunur — dönüştürülmez.
# WEBP_CONVERT=true
# WEBP_QUALITY=82             → 0-100 arası; 82 iyi kalite/boyut dengesi

# ── Dosya Yükleme Limitleri ──────────────────────────────────
# Max upload boyutu MB — production'da 100-500 arası önerilir.
# Chunked upload endpoint'i bu limiti destekler; legacy endpoint 500MB hardcoded.
MAX_FILE_SIZE_MB=5120
CHUNK_SIZE_MB=5

# ── Sentry (opsiyonel) ───────────────────────────────────────
# SERVER_SENTRY_DSN=
# CLIENT_SENTRY_DSN=

# ── Captcha (opsiyonel) ──────────────────────────────────────
# CAPTCHA_SECRET=
# CAPTCHA_SITEKEY=

# ── Rate Limit Özelleştirme (opsiyonel) ──────────────────────
# Tüm varsayılanlar server/middleware/rateLimit.ts içinde
# RL_LOGIN_MAX=10
# RL_LOGIN_WIN=60000
# RL_REGISTER_MAX=5
# RL_REGISTER_WIN=60000

# ── Güvenilir Proxy Sayısı ───────────────────────────────────
# Nginx/Cloudflare arkasındaysa: 1 veya daha fazla
TRUSTED_PROXY_COUNT=1

# ── Loglama ─────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── APNs HTTP/2 (iOS Native Push — p8 key) ────────────────────────────────
# APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.yourcompany.bridge
# APNS_ENV=sandbox   # production veya sandbox

# ── Mediasoup Dinamik Worker Ölçekleme ────────────────────────────────────
# SFU_SCALE_UP_ROUTERS=20     # worker başına bu kadar router → yeni worker aç
# SFU_SCALE_DOWN_ROUTERS=5    # bu kadarın altına düşünce boş worker kapat
# SFU_MIN_WORKERS=1           # minimum worker sayısı
# SFU_MAX_WORKERS=8           # maksimum worker sayısı (CPU çekirdeği sayısını geçme)
# SFU_SCALE_CHECK_MS=30000    # ölçekleme kontrol aralığı (ms)

# ══════════════════════════════════════════════════════════════
# ── Güvenlik & Admin ─────────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# İlk admin hesabını oluşturmak için kullanılan tek seferlik sır.
# POST /api/admin/setup { secret: "..." } ile kullanılır.
# Production'da güçlü bir değer seç ve kurulumdan sonra değiştir.
# ADMIN_SETUP_SECRET=CHANGE_ME_openssl_rand_hex_32

# Bot token imzalamak için HMAC sırrı. JWT_SECRET'tan farklı olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOT_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32

# Uygulama base URL'si (ActivityPub, deep link, e-posta linkleri için)
# Production'da PUBLIC HTTPS URL olmalı
# BASE_URL=https://bridge.example.com
# APP_URL=https://bridge.example.com

# Kayıt kapatma (invite-only mod için)
# DISABLE_REGISTRATION=false

# Tor çıkış node'larından gelen bağlantıları engelle
# BLOCK_TOR=false

# İçerik tarama (NSFW/spam ML modeli — opsiyonel)
# CONTENT_SCAN_ENABLED=false

# CSAM hash listesi (PhotoDNA benzeri tarama — son derece opsiyonel)
# CSAM_HASH_LIST_FILE=/path/to/hash-list.txt
# CSAM_HASH_LIST=

# ── IP Kara Liste & İtibar ──────────────────────────────────

# IP itibar kontrolü (AbuseIPDB entegrasyonu)
# IP_REPUTATION_ENABLED=true
# IP_BLOCKLIST_PATH=/path/to/blocklist.txt

# AbuseIPDB API (IP_REPUTATION_ENABLED=true ise opsiyonel)
# https://www.abuseipdb.com/api
# ABUSEIPDB_KEY=
# ABUSEIPDB_THRESHOLD=85         → 0-100; bu puan üstü engellenir
# ABUSEIPDB_CACHE_TTL=3600       → saniye; IP puanı cache süresi

# SSRF koruması — izin verilen domain/IP listesi (boşlukla ayrılmış)
# SSRF_ALLOWLIST=example.com webhooks.example.com

# ── Content Security Policy Genişletme ─────────────────────

# Özel connect-src ve img-src eklemek için (CSP header'a eklenir)
# EXTRA_CONNECT_SRC=wss://custom.domain.com
# EXTRA_IMG_SRC=https://custom-cdn.com

# ══════════════════════════════════════════════════════════════
# ── Kimlik Doğrulama: OIDC / SSO ─────────────────────────────
# ══════════════════════════════════════════════════════════════

# OpenID Connect (Keycloak, Okta, Auth0, Google Workspace vb.)
# OIDC_ENABLED=false
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile    → boşlukla ayrılmış

# SAML 2.0 (kurumsal SSO)
# SAML_ENABLED=false
# SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# SAML_ISSUER=bridge
# SAML_IDP_CERT=                      → IdP'nin base64 X.509 sertifikası

# ══════════════════════════════════════════════════════════════
# ── Captcha Sağlayıcıları ────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Captcha genel açma/kapama
# CAPTCHA_ENABLED=false

# hCaptcha (önerilir — gizlilik odaklı)
# HCAPTCHA_SITEKEY=
# HCAPTCHA_SECRET=

# Cloudflare Turnstile
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=

# Captcha token TTL (saniye, varsayılan: 300)
# CAPTCHA_TOKEN_TTL=300

# Kaç başarısız girişten sonra captcha zorunlu olsun?
# PROGRESSIVE_CAPTCHA_THRESHOLD=3

# ── Giriş Güvenliği ────────────────────────────────────────

# Kaç başarısız girişten sonra hesap kilitlensin?
# MAX_FAILED_LOGINS=5
# LOGIN_LOCKOUT_MS=900000            → ms; varsayılan 15 dakika

# Saatte kaç kayıt olabilsin?
# MAX_REG_PER_HOUR=3

# ══════════════════════════════════════════════════════════════
# ── Veritabanı Gelişmiş ──────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# PostgreSQL SSL (production'da önerilir)
# DATABASE_SSL=true

# Connection pool büyüklüğü (varsayılan: 20)
# PG_POOL_MAX=20

# Veri dizini override (SQLite modu için)
# DATA_DIR_OVERRIDE=/custom/path/data

# ══════════════════════════════════════════════════════════════
# ── Prometheus Metrikleri ────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# METRICS_ENABLED=true               → false yaparak kapatılabilir
# METRICS_PREFIX=bridge_             → tüm metric adları bu prefix ile başlar
# METRICS_SECRET=                    → /metrics endpoint için Bearer token (boşsa herkese açık)

# ── OpenTelemetry ──────────────────────────────────────────

# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   → OTLP/HTTP
# OTEL_SERVICE_NAME=bridge-server
# OTEL_EXPORTER_OTLP_HEADERS=       → "key=value,key2=value2" formatı

# ── Sentry (Detaylı) ───────────────────────────────────────

# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=bridge@1.0.0        → npm version veya git SHA
# SENTRY_TRACES_SAMPLE_RATE=0.05     → 0.0-1.0; %5 trace örnekleme

# ══════════════════════════════════════════════════════════════
# ── MediaSoup SFU (Ses / Video) ──────────────────────────────
# ══════════════════════════════════════════════════════════════

# Kaç MediaSoup worker açılsın? (varsayılan: 1, max: CPU çekirdeği)
# MEDIASOUP_WORKERS=1

# Worker'ların dinleyeceği IP (0.0.0.0 = tüm arayüzler)
# MEDIASOUP_LISTEN_IP=0.0.0.0

# Dışarıdan erişilecek genel IP (NAT arkasındaysan PUBLIC IP gir)
# MEDIASOUP_ANNOUNCED_IP=1.2.3.4

# RTC port aralığı (UDP, güvenlik duvarında açık olmalı)
# MEDIASOUP_RTC_MIN_PORT=40000
# MEDIASOUP_RTC_MAX_PORT=49999

# Ses kalitesi (kbps)
# MEDIASOUP_OPUS_BITRATE=64          → varsayılan 64 kbps

# Video kalitesi (kbps)
# MEDIASOUP_VIDEO_MAX_BITRATE=3000   → varsayılan 3000 kbps
# MEDIASOUP_SCREEN_BITRATE=2500      → ekran paylaşımı

# Metered TURN (opsiyonel TURN sağlayıcısı)
# METERED_APP_NAME=
# METERED_API_KEY=

# TURN sunucu bağlantı bilgileri (kendi COTURN sunucun varsa)
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURN_TLS_PORT=5349
# TURN_USERNAME=bridge
# TURN_CREDENTIAL=
# TURN_SECRET=                       → HMAC-SHA1 için shared secret
# TURN_URL=turn:turn.example.com:3478
# TURN_URL_TLS=turns:turn.example.com:5349

# Sprint 120 / I7 — WebRTC IP sızıntısı koruması
# FORCE_TURN=false  → true yapılırsa tüm WebRTC trafiği TURN üzerinden zorlanır
#                     (kullanıcı IP'leri diğer katılımcılara sızmaz)
#                     DİKKAT: TURN_URL + TURN_USERNAME + TURN_CREDENTIAL zorunlu;
#                     TURN yapılandırılmamışken true yaparsan tüm ses/video kesilir.
FORCE_TURN=false

# Sprint 120 / D5 — WebSocket bağlantı limiti (DDoS/flood koruması)
MAX_WS_PER_IP=10          # Tek IP'den max eş zamanlı WS bağlantısı
MAX_UNAUTH_WS_PER_IP=3    # Auth tamamlanmamış bağlantılar için daha düşük limit
MAX_WS_PER_USER=5         # Tek kullanıcının açabileceği max sekme/cihaz sayısı

# Sprint 120 / D6 — ActivityPub inbox flood koruması
AP_INBOX_GLOBAL_MAX=500   # Tüm peer'lardan toplam 60s'de max inbox aktivitesi
AP_INBOX_PEER_MAX=100     # Tek peer'dan 60s'de max aktivite
AP_INBOX_BURST_MAX=20     # Tek peer'dan 10s'de max burst

# STUN sunucuları (boşlukla ayrılmış, varsayılan: Google STUN)
# STUN_URLS=stun:stun.l.google.com:19302 stun:stun1.l.google.com:19302

# Tüm medyayı TURN üzerinden zorla (test için)
# FORCE_RELAY=false

# ══════════════════════════════════════════════════════════════
# ── Firebase Cloud Messaging (Android Push) ───────────────────
# ══════════════════════════════════════════════════════════════

# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# FCM_SERVICE_ACCOUNT_JSON=          → JSON içeriğini string olarak da verebilirsin

# ══════════════════════════════════════════════════════════════
# ── Ses Kaydı / Go Live ──────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Ses kaydı maksimum süresi (saniye, varsayılan: 120)
# MAX_RECORDING_SECS=120

# Kayıt dosyalarının saklanacağı dizin
# RECORDINGS_DIR=/var/bridge/recordings

# ══════════════════════════════════════════════════════════════
# ── Çizim Tuvali (Canvas) ────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Kanal başına maksimum çizgi sayısı (varsayılan: 2000)
# CANVAS_MAX_STROKES=2000

# Canvas verisi TTL saniye (varsayılan: 86400 = 24 saat)
# CANVAS_TTL_SECONDS=86400

# Kanal başına maksimum eş zamanlı canvas istemcisi (varsayılan: 20)
# MAX_CANVAS_CLIENTS_PER_CHANNEL=20

# ══════════════════════════════════════════════════════════════
# ── Çeviri (LibreTranslate) ──────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Self-hosted LibreTranslate veya public instance
# LIBRETRANSLATE_URL=https://libretranslate.com
# LIBRETRANSLATE_API_KEY=            → public instance için gerekebilir
# LIBRETRANSLATE_KEY=                → alias (ikisi de çalışır)

# ══════════════════════════════════════════════════════════════
# ── Spotify Entegrasyonu ─────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# "Şu an çalınan" özelliği için Spotify OAuth2
# https://developer.spotify.com/dashboard → uygulama oluştur
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://bridge.example.com/api/spotify/callback

# ══════════════════════════════════════════════════════════════
# ── Tenor GIF Entegrasyonu ────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Tenor GIF arama (boşsa GIF özelliği devre dışı)
# https://tenor.com/developer → API key al
# TENOR_API_KEY=

# ══════════════════════════════════════════════════════════════
# ── VirusTotal (Dosya Tarama) ────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Yüklenen dosyaları VirusTotal ile tara (opsiyonel)
# VIRUSTOTAL_API_KEY=

# ══════════════════════════════════════════════════════════════
# ── HTTP Fetch Zaman Aşımı ───────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Link preview, ActivityPub fetch vb. için HTTP timeout (ms, varsayılan: 5000)
# HTTP_FETCH_TIMEOUT_MS=5000

# ══════════════════════════════════════════════════════════════
# ── Sunucu Kimliği (Federasyon / Hakkında Sayfası) ───────────
# ══════════════════════════════════════════════════════════════

# INSTANCE_ID=                       → benzersiz instance ID (otomatik üretilir)
# INSTANCE_DESC=Kendi Bridge sunucum  → hakkında sayfasında gösterilir

# ══════════════════════════════════════════════════════════════
# ── Proxy & Ağ ───────────────────────────────────────────────
# ══════════════════════════════════════════════════════════════

# Güvenilen proxy IP'leri (virgülle ayrılmış, TRUSTED_PROXY_COUNT'un yerine geçer)
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# ══════════════════════════════════════════════════════════════
# ── Rate Limit — Tüm Endpointler (Tam Liste) ─────────────────
# ══════════════════════════════════════════════════════════════
# Format: MAX = istek sayısı, WIN = pencere ms
# Varsayılanlar aşağıda gösterilmiştir — sadece değiştirmek istediklerini uncomment et

# RL_GLOBAL_MAX=300          RL_GLOBAL_WIN=60000        → Genel limit (tüm istekler)
# RL_LOGIN_MAX=10            RL_LOGIN_WIN=60000          → Giriş
# RL_REGISTER_MAX=5          RL_REGISTER_WIN=60000       → Kayıt
# RL_REFRESH_MAX=30          RL_REFRESH_WIN=60000        → Token yenileme
# RL_CHGPWD_MAX=3            RL_CHGPWD_WIN=300000        → Şifre değiştirme (5 dk)
# RL_MESSAGES_MAX=30         RL_MESSAGES_WIN=60000       → Mesaj gönderme
# RL_UPLOAD_MAX=20           RL_UPLOAD_WIN=60000         → Dosya yükleme
# RL_REACT_MAX=60            RL_REACT_WIN=60000          → Reaksiyon
# RL_SEARCH_MAX=20           RL_SEARCH_WIN=60000         → Arama
# RL_AI_MAX=10               RL_AI_WIN=60000             → AI istek
# RL_AI_STREAM_MAX=5         RL_AI_STREAM_WIN=60000      → AI streaming
# RL_DM_MAX=20               RL_DM_WIN=60000             → DM mesajı
# RL_INVITE_MAX=10           RL_INVITE_WIN=60000         → Davet oluşturma
# RL_FRIENDS_MAX=20          RL_FRIENDS_WIN=60000        → Arkadaşlık
# RL_SERVERS_MAX=10          RL_SERVERS_WIN=60000        → Sunucu işlemleri
# RL_ROLES_MAX=20            RL_ROLES_WIN=60000          → Rol işlemleri
# RL_CHANNELS_MAX=20         RL_CHANNELS_WIN=60000       → Kanal işlemleri
# RL_SETTINGS_MAX=10         RL_SETTINGS_WIN=60000       → Ayarlar
# RL_POLLS_MAX=10            RL_POLLS_WIN=60000          → Anket
# RL_WEBHOOKS_MAX=15         RL_WEBHOOKS_WIN=60000       → Webhook
# RL_FEDERATION_MAX=30       RL_FEDERATION_WIN=60000     → Federasyon
# RL_MODERATION_MAX=30       RL_MODERATION_WIN=60000     → Moderasyon
# RL_EMAIL_MAX=5             RL_EMAIL_WIN=300000         → E-posta (5 dk)
# RL_BOTS_MAX=20             RL_BOTS_WIN=60000           → Bot API
# RL_WRITE_MAX=30            RL_WRITE_WIN=60000          → Genel yazma
# RL_VOICE_STATE_MAX=30      RL_VOICE_STATE_WIN=10000    → Ses durumu (10 sn)
# RL_SOCKET_CONNECT_MAX=10                               → WebSocket bağlantı
# RL_SOCKET_HS_MAX=20                                    → Socket handshake

# Otomatik IP banlama (HTTP)
# RL_HTTP_AUTO_BAN_THRESHOLD=10      → Bu kadar 429 sonra IP ban
# RL_HTTP_AUTO_BAN_DURATION=600000   → Ban süresi ms (varsayılan: 10 dk)
# RL_AUTO_BAN_THRESHOLD=50           → Socket için
# RL_AUTO_BAN_DURATION=600000        → Socket ban süresi ms

# ═══════════════════════════════════════════════════════════════════
# VAULT / SECRETS MANAGER (Sprint 112 — ADR-0012)
# ═══════════════════════════════════════════════════════════════════
# Backend seçimi: env | hashicorp | aws (varsayılan: env)
# VAULT_BACKEND=env

# HashiCorp Vault (VAULT_BACKEND=hashicorp)
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=hvs.xxxxxxxxxxxxxxxxxxxxxxxx
# VAULT_ROLE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # AppRole
# VAULT_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx # AppRole
# VAULT_MOUNT=secret          # KV v2 mount path (varsayılan: secret)
# VAULT_PATH_PREFIX=bridge    # Sır yolu prefix'i (varsayılan: bridge)

# AWS Secrets Manager (VAULT_BACKEND=aws)
# AWS_REGION=us-east-1
# AWS_SECRET_PREFIX=bridge/   # Secret adı prefix'i

# ═══════════════════════════════════════════════════════════════════
# PGVECTOR / EMBEDDING (Sprint 112 — ADR-0011)
# ═══════════════════════════════════════════════════════════════════
# Semantik arama için pgvector embedding (varsayılan: devre dışı)
# PGVECTOR_ENABLED=false

# Embedding provider: nomic | ollama | openai (varsayılan: nomic)
# EMBEDDING_PROVIDER=nomic

# Ollama / Nomic (yerel, API key gerektirmez)
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text

# OpenAI Embedding (EMBEDDING_PROVIDER=openai ise)
# OPENAI_API_KEY=sk-proj-xxxxxxxx

# Vektör boyutu — modele göre değiştirilmeli:
#   nomic-embed-text → 768
#   text-embedding-3-small → 1536
# EMBEDDING_DIMENSION=768


# Sunucu başına max kanal sayısı (resource exhaustion önleme)
MAX_CHANNELS_PER_SERVER=500
# Kullanıcı başına max sahip olunan sunucu sayısı
MAX_SERVERS_PER_USER=100
