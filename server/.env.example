# ══════════════════════════════════════════════════════
# BRIDGE — .env Yapılandırma
# ══════════════════════════════════════════════════════

# ── Zorunlu ──────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_STRING

# Üretmek için:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Sunucu ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001

# ── Token ─────────────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Dosya Yükleme ─────────────────────────────────────
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE_MB=5

# ══════════════════════════════════════════════════════
# VERİTABANI — PostgreSQL (ZORUNLU)
# ══════════════════════════════════════════════════════
#
# Kurulum:
#   createdb bridge
#   DATABASE_URL=... npm start   (ilk çalışmada schema otomatik oluşur)
#
# Bağlantı formatı:
DATABASE_URL=postgresql://bridge_user:guclu_sifre@localhost:5432/bridge
#
# SSL (Render, Railway, Heroku gibi yönetilen DB'ler için):
# DATABASE_SSL=true
#
# Pool ayarları (opsiyonel):
# PG_POOL_MAX=20

# ── Redis (multi-instance için zorunlu) ───────────────
# Tek instance çalıştırıyorsan opsiyonel.
# REDIS_URL=redis://localhost:6379

# ══════════════════════════════════════════════════════
# AI ÖZELLİKLERİ — TAMAMEN ÜCRETSİZ SEÇENEKLER
# ══════════════════════════════════════════════════════

# SEÇENEK 1: GROQ (önerilen) — groq.com → ücretsiz
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# SEÇENEK 2: Google Gemini — aistudio.google.com → ücretsiz
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# SEÇENEK 3: OpenRouter — openrouter.ai → ücretsiz modeller
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# SEÇENEK 4: Ollama (yerel, sınırsız)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# SEÇENEK 5: LibreTranslate (sadece çeviri)
# LIBRETRANSLATE_URL=http://localhost:5000

# ══════════════════════════════════════════════════════
# DİĞER AYARLAR
# ══════════════════════════════════════════════════════

# GIF (Tenor)
# TENOR_API_KEY=

# Push Bildirimleri
# npx web-push generate-vapid-keys
# Web Push bildirimleri için VAPID anahtarları — ZORUNLU (web push aktif edilecekse)
# Oluşturmak için: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@yourdomain.com

# Bot API
# BOT_TOKEN_SECRET=CHANGE_ME_BOT_SECRET

# Hız Limitleri
RL_REGISTER_MAX=10
RL_REGISTER_WIN=60000
RL_LOGIN_MAX=20
RL_LOGIN_WIN=60000

# ══════════════════════════════════════════════════════
# FEDERATION
# ══════════════════════════════════════════════════════
# INSTANCE_NAME=Bridge Türkiye
# INSTANCE_DESC=Türkçe Bridge topluluğu
# INSTANCE_URL=https://bridge.example.com
# FEDERATION_SECRET=guclu-gizli-bir-anahtar

# ══════════════════════════════════════════════════════
# E-POSTA / SMTP
# ══════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=senin@gmail.com
# SMTP_PASS=uygulama-sifresi
# SMTP_FROM="Bridge" <noreply@bridge.local>

# ══════════════════════════════════════════════════════
# GÜVENLİK
# ══════════════════════════════════════════════════════
# ADMIN_SETUP_SECRET=cok-gizli-bir-sifre
# CAPTCHA_ENABLED=false
# HCAPTCHA_SITEKEY=
# HCAPTCHA_SECRET=
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=
# IP_REPUTATION_ENABLED=false
# ABUSEIPDB_KEY=
# BLOCK_TOR=false

# ══════════════════════════════════════════════════════
# WEBAUTHN / PASSKEY
# ══════════════════════════════════════════════════════
# WebAuthn Relying Party (RP) yapılandırması
# Face ID, Touch ID, Windows Hello, YubiKey ile şifresiz giriş
#
# RP_ID: Domain adı (localhost veya yourdomain.com)
# RP_NAME: Kullanıcıya gösterilecek uygulama adı
# ORIGIN: Tam URL (protokol + domain + port)
#
# Üretim ortamı örneği:
# WEBAUTHN_RP_ID=bridge.example.com
# WEBAUTHN_RP_NAME=Bridge
# WEBAUTHN_ORIGIN=https://bridge.example.com
#
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bridge
WEBAUTHN_ORIGIN=http://localhost:3001

# ══════════════════════════════════════════════════════
# FCM (Mobil Push — iOS + Android)
# ══════════════════════════════════════════════════════
# FCM_SERVICE_ACCOUNT_PATH=/etc/bridge/firebase-service-account.json
# FCM_PROJECT_ID=your-firebase-project-id

# ══════════════════════════════════════════════════════
# MEDIASOUP SFU — Grup Ses/Video (SFU modu)
# ══════════════════════════════════════════════════════
# ZORUNLU: Sunucunun dışarıdan erişilebilir public IP'si.
# Bu değer boş bırakılırsa group voice çalışmaz (P2P fallback devreye girer).
# Oluşturmak için: curl -s https://api.ipify.org
MEDIASOUP_ANNOUNCED_IP=1.2.3.4
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_WORKERS=1

# ══════════════════════════════════════════════════════
# CDN DEPOLAMA — Cloudflare R2 / Backblaze B2 / local
# ══════════════════════════════════════════════════════
# CDN_PROVIDER=local         # local | r2 | b2  (default: local)
#
# -- Cloudflare R2 (CDN_PROVIDER=r2) --
# R2_ACCOUNT_ID=your-cf-account-id
# R2_ACCESS_KEY_ID=your-r2-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret
# R2_BUCKET=bridge-uploads
# R2_PUBLIC_URL=https://cdn.yourdomain.com
#
# -- Backblaze B2 (CDN_PROVIDER=b2) --
# B2_KEY_ID=your-b2-key-id
# B2_APP_KEY=your-b2-app-key
# B2_BUCKET_ID=your-b2-bucket-id
# B2_BUCKET_NAME=bridge-uploads
# B2_REGION=us-west-004
# B2_PUBLIC_URL=https://cdn.yourdomain.com   # Cloudflare CDN önünde ise bu

# ══════════════════════════════════════════════════════
# MEDIASOUP — Ses + Video kalitesi
# ══════════════════════════════════════════════════════
# MEDIASOUP_OPUS_BITRATE=64          # kbps (müzik odaları için 128 önerilir)
# MEDIASOUP_VIDEO_MAX_BITRATE=3000   # kbps (3Mbps varsayılan)
# MEDIASOUP_SCREEN_BITRATE=2500      # kbps (ekran paylaşımı)

# ── TURN SUNUCU (ses/video NAT traversal) ────────────────────────────────────
# TURN olmadan kurumsal ağlar, simetrik NAT, güvenlik duvarı arkasındaki
# kullanıcılar WebRTC ses/video bağlantısı kuramaz.
#
# SEÇENEK 1 — Self-hosted coturn (önerilen):
TURN_HOST=turn.seninadresi.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=gizli_coturn_secret_buraya   # coturn --use-auth-secret ile uyumlu
# TURN_TLS_443=true                       # 443 üzerinden TURN (kurumsal firewall bypass)
#
# SEÇENEK 2 — Statik credential (Metered.ca / başka sağlayıcı):
# TURN_URL=turn:eu.relay.metered.ca:80
# TURN_URL_TLS=turns:eu.relay.metered.ca:443
# TURN_USERNAME=kullanici
# TURN_CREDENTIAL=sifre
#
# STUN listesini override etmek için (virgülle ayrılmış):
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# Debug: yalnızca TURN üzerinden bağlantıya zorla (test amaçlı):
# FORCE_RELAY=true

# ── SFU CLUSTER (multi-node) ─────────────────────────────────────────────────
# Birden fazla Bridge node çalışırken ses odaları farklı node'lara dağılır.
# sfuRegistry Redis'e hangi odanın hangi node'da olduğunu kaydeder.
# REDIS_URL zaten tanımlıysa sfuRegistry otomatik aktif olur.
# Her node'a benzersiz ID ver:
# INSTANCE_ID=bridge-1   # docker-compose.cluster.yml otomatik ayarlıyor

# ── CLIENT SENTRY (Hata Takibi) ─────────────────────────────────────────────
# Tarayıcı tarafı hata izleme için Sentry DSN.
# Bu değer PUBLIC — tarayıcıya gönderilir, gizli anahtar değil.
# Boş bırakılırsa Sentry devre dışı kalır (hiç veri gönderilmez).
# Sentry projesi oluşturma: https://sentry.io → New Project → Browser JS
# CLIENT_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Uygulama ortamı (Sentry event'lerinde görünür):
# BRIDGE_ENV=production
