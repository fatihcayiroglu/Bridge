{
  "_comment": "Jest / ts-jest için özel tsconfig. Test dosyalarını include eder.",
  "_todo": "Sprint 57 ✅ tests/helpers/*.js → .ts migrate edildi (index, mocks, mockDb). helpers/*.js satırı kaldırıldı.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Test dosyalarında strict kapalı — geçiş döneminde test altyapısı etkilenmesin
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "allowJs": true,
    "checkJs": false,
    // incremental kapalı — ts-jest diagnostics için stale cache gizlemesi istenmiyor
    "incremental": false
  },
  "include": [
    "index.ts",
    "app/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts",
    "lib/**/*.ts",
    "db/**/*.ts",
    "jobs/**/*.ts",
    "socket/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.js",
    "db/repositories/types/*.d.ts",
    // Test dosyaları — Sprint 55: tümü .ts'e dönüştürüldü
    "tests/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "_legacy_js_backup_session4_5",
    "db/repositories/_legacy_js_backup_session8"
  ]
}
