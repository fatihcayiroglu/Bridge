{
  /**
   * Bridge — TypeScript Geçiş Fazı 1
   * server/db/repositories/tsconfig.json
   *
   * Sadece repositories katmanını kapsar.
   * Mevcut .js dosyaları "allowJs: true" ile dahil edilir.
   * Tip hataları henüz derlemeyi kırmaz (strict: false) — Faz 1 hedefi
   * mevcut koda dokunmadan IDE desteği + .d.ts çıktısı.
   *
   * Geçiş Takvimi:
   *   Faz 1 (Sprint 8) : allowJs + checkJs false — sadece .d.ts dosyaları
   *   Faz 2 (Sprint 9) : checkJs: true → mevcut JS'te tip hataları görünür
   *   Faz 3 (Sprint 10): Kritik repo'lar .ts'ye çevrilir (User, Message, Member)
   *   Faz 4 (Sprint 11): strict: true + tüm katman
   */
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],

    /* Faz 1: JS kabul et, ama henüz tip hatası verme */
    "allowJs": true,
    "checkJs": false,

    /* .d.ts çıktısı — IDE ve SDK üretimi için */
    "declaration": true,
    "declarationDir": "./types/generated",
    "emitDeclarationOnly": true,

    /* Yol çözümlemesi */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Çıktı */
    "outDir": "./dist",
    "rootDir": ".",

    /* Henüz strict değil — Faz 3'te açılacak */
    "strict": false,
    "noImplicitAny": false,

    /* Faz 2'de açılacak kontroller */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,

    /* Her zaman açık kalacak */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "*.js",
    "*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types/generated"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
