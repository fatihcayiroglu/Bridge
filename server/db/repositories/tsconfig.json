{
  /**
   * Bridge — server/db/repositories/tsconfig.json
   *
   * DÜZELTME #10: Çift derleme / çakışan outDir riski giderildi.
   *   - Bu config server/tsconfig.json'a extends eder.
   *   - server/tsconfig.json "include" listesi zaten db/**\/*.ts'yi
   *     kapsar; bu config yalnızca declaration emit ve IDE amaçlıdır.
   *
   * Sprint 26: strict:true base'e alındı. Faz 1–3 geçiş override'ları
   *   (strict:false, noImplicitAny:false vb.) kaldırıldı — repo dosyaları
   *   Sprint 10–11'den beri fully typed, override'ların gerekçesi kalmadı.
   *
   * Sprint 15+ TODO: server/tsconfig.json tek başına yeterli;
   *   bu dosya declaration emit gerekmediğinde kaldırılabilir.
   */
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Declaration çıktısı — IDE ve SDK üretimi için */
    "declaration": true,
    "declarationDir": "./types/generated",
    "emitDeclarationOnly": true,

    /* Çift outDir çakışmasını önle */
    "outDir": "./dist",
    "rootDir": ".",

    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "*.js",
    "*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types/generated",
    "_legacy_js_backup_session8"
  ]
}
