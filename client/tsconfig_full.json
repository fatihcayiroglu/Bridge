{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["DOM", "ES2020"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["js/**/*.ts"],
  "exclude": ["node_modules", "dist-session5"]
}
