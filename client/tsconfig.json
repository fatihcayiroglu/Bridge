{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.svelte"
  ],
  "exclude": [
    "node_modules",
    "dist-session5"
  ],
  "__migration_note__": "Final14 hardening: base config now preserves full strict null/implicit-any/catch semantics; svelte-check consumes this config."
}
